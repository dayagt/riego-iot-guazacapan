# =====================================================================
# Variables de entorno del prototipo RiegoIoT
# Copia este archivo como ".env" y cambia los valores marcados.
# (PowerShell:  Copy-Item .env.example .env)
# =====================================================================

# Puerto donde se levanta el backend y el panel (http://localhost:3000)
PUERTO=3000

# Zona horaria para las fechas que se guardan en la base de datos
TZ=America/Guatemala

# Archivo de la base de datos SQLite (ruta relativa a la carpeta del proyecto)
DB_ARCHIVO=database/riego.db

# Secreto para firmar los tokens JWT (cámbialo por un texto largo y aleatorio)
JWT_SECRETO=cambia_este_secreto_por_uno_largo_y_aleatorio
# Duración de la sesión (ej. 8h, 30m)
JWT_EXPIRA=8h

# Clave que el ESP32 / simulador envía en la cabecera "x-api-key"
DISPOSITIVO_API_KEY=cambia_esta_clave_del_dispositivo

# Umbral de humedad (%) con el que se crea la base de datos la primera vez
UMBRAL_INICIAL=35

# Caudal de la bomba en litros por minuto (para estimar el agua usada)
CAUDAL_BOMBA_LPM=10

# Margen de apagado (puntos de %): la bomba automática se apaga cuando la
# humedad llega a (umbral + margen). Evita que la bomba se prenda y apague
# a cada rato cuando la humedad ronda el umbral (histéresis).
MARGEN_APAGADO=10

# Segundos que se respeta una orden manual (encender/apagar desde el panel)
# antes de que el control automático vuelva a decidir.
MANUAL_DURACION_SEG=60
